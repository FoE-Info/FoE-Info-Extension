{
  "name": "foe-info",
  "displayName": "FoE-Info Extension",
  "version": "0.0.834",
  "private": true,
  "description": "Essential Info browser extension for Forge of Empires players",
  "license": "AGPL-3.0-or-later",
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/js/ui/renderBindings.js",
    "src/js/ui/*RenderBinding.js"
  ],
  "type": "commonjs",
  "scripts": {
    "browser": "foe-browser",
    "browser:reload": "foe-browser --reload-ext",
    "browser:restart": "foe-browser --restart",
    "build": "webpack --config webpack.config.js --env target=prod",
    "build:beta": "webpack --config webpack.config.js --env target=beta",
    "build:dev": "webpack --config webpack.config.js --env target=dev",
    "build:prod": "webpack --config webpack.config.js --env target=prod",
    "check": "prettier --check .",
    "clean": "rm -rf build",
    "dev": "webpack --config webpack.config.js --env target=dev --watch",
    "format": "prettier --write .",
    "graph:foe-info:ast": "bash .agents/scripts/graph-foe-info-ast.sh",
    "graph:foe-info:export": "GRAPHIFY_OUT=graphify-out/foe-info graphify export wiki && GRAPHIFY_OUT=graphify-out/foe-info graphify export callflow-html && GRAPHIFY_OUT=graphify-out/foe-info graphify export obsidian && GRAPHIFY_OUT=graphify-out/foe-info graphify export svg && GRAPHIFY_OUT=graphify-out/foe-info graphify export html && GRAPHIFY_OUT=graphify-out/foe-info graphify tree",
    "graph:foe-info:reindex": "bash .agents/scripts/graph-foe-info-reindex.sh",
    "graph:foe-info:update": "bash .agents/scripts/graph-foe-info-update.sh",
    "graph:foe-info:watch": "GRAPHIFY_OUT=graphify-out/foe-info bash .agents/scripts/run-graphify-local.sh watch .",
    "graph:foe-info-original:ast": "bash .agents/scripts/graph-foe-info-original-ast.sh",
    "graph:foe-info-original:export": "(cd ../FoE-Info-Extension-original && graphify export wiki && graphify export callflow-html && graphify export obsidian && graphify export svg && graphify export html && graphify tree)",
    "graph:foe-info-original:reindex": "bash .agents/scripts/graph-foe-info-original-reindex.sh",
    "graph:foe-info-original:update": "bash .agents/scripts/graph-foe-info-original-update.sh",
    "graph:forge-hammer:ast": "bash .agents/scripts/graph-forge-hammer-ast.sh",
    "graph:forge-hammer:export": "(cd ../forge-hammer && graphify export wiki && graphify export callflow-html && graphify export obsidian && graphify export svg && graphify export html && graphify tree)",
    "graph:forge-hammer:reindex": "bash .agents/scripts/graph-forge-hammer-reindex.sh",
    "graph:forge-hammer:update": "bash .agents/scripts/graph-forge-hammer-update.sh",
    "graph:low-tool:ast": "bash .agents/scripts/graph-low-tool-ast.sh",
    "graph:low-tool:export": "(cd ../LoW-Tool && graphify export wiki && graphify export callflow-html && graphify export obsidian && graphify export svg && graphify export html && graphify tree)",
    "graph:low-tool:reindex": "bash .agents/scripts/graph-low-tool-reindex.sh",
    "graph:low-tool:update": "bash .agents/scripts/graph-low-tool-update.sh",
    "graph:metadata:export": "(cd ../metadata-store && graphify export wiki && graphify export obsidian && graphify export svg && graphify tree)",
    "graph:metadata:reindex": "bash .agents/scripts/graph-metadata-reindex.sh",
    "graph:metadata:update": "bash .agents/scripts/graph-metadata-update.sh",
    "i18n:check": "node scripts/audit-i18n.mjs",
    "i18n:fix": "node scripts/audit-i18n.mjs --fix",
    "inspect": "node .agents/scripts/inspect-extension.js 5000",
    "inspect:panel": "node .agents/scripts/inspect-extension.js 5000 --target panel.html",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "metadata:download": "node scripts/download-offline-metadata.mjs",
    "metadata:extract-hars": "node scripts/ingest-hars-to-metadata.mjs",
    "metadata:query": "node scripts/query-metadata-store.mjs",
    "package:beta": "npm run verify && node scripts/package-extension.js --env=beta",
    "prepare": "husky",
    "release": "node scripts/release.mjs",
    "release:prod": "npm run lint && npm run test && npm run build:prod && node scripts/package-extension.js --env=prod",
    "rpc:contract": "node scripts/rpc-contract.mjs",
    "rpc:contract:check": "node scripts/rpc-contract.mjs --check",
    "test": "node --test tests/**/*.test.mjs",
    "test:cdp": "node tests/cdp/run-all.mjs",
    "test:cdp:devtools": "node tests/cdp/devtools-reload.mjs",
    "test:cdp:popovers": "node tests/cdp/panel-popovers.mjs",
    "test:watch": "node --test --watch tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run lint && npm run typecheck && npm run rpc:contract:check && npm run i18n:check && npm test && npm run build:dev"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bignumber.js": "^11.1.5",
    "bootstrap": "^5.3.8",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "@types/webextension-polyfill": "^0.12.6",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "shell-quote": "^1.10.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true
  },
  "primaryGraph": "graphify-foe-info"
}
