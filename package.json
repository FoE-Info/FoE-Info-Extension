{
  "name": "foe-info",
  "version": "0.0.832",
  "private": true,
  "description": "Essential Info browser extension for Forge of Empires players",
  "license": "AGPL-3.0-or-later",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.dev.js",
    "build-foe-info": "webpack --config webpack.prod.js",
    "check": "prettier --check .",
    "dev": "webpack --config webpack.dev.js --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.{json,css,scss,html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@wikimedia/jquery.i18n": "1.0.9",
    "bignumber.js": "^9.3.1",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.23",
    "jquery": "^3.7.1",
    "webextension-polyfill": "^0.12.0",
    "webhook-discord": "^3.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "file-loader": "^6.2.0",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "license-webpack-plugin": "^4.0.2",
    "lint-staged": "^17.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "sass": "^1.103.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.110.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-dev-server": "^6.0.0",
    "webpack-extension-manifest-plugin": "^0.8.0",
    "webpack-merge": "^6.0.1",
    "zip-webpack-plugin": "^4.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true
  }
}
