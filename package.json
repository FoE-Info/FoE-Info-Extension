{
  "name": "foe-info",
  "displayName": "FoE-Info Extension",
  "version": "0.0.834",
  "private": true,
  "description": "Essential game information panels for Forge of Empires players",
  "license": "AGPL-3.0-or-later",
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/js/ui/renderBindings.js",
    "src/js/ui/*RenderBinding.js"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "webpack --config webpack.config.js --env target=prod",
    "build:beta": "webpack --config webpack.config.js --env target=beta",
    "build:dev": "webpack --config webpack.config.js --env target=dev",
    "build:prod": "webpack --config webpack.config.js --env target=prod",
    "check": "prettier --check .",
    "clean": "rm -rf build",
    "dev": "webpack --config webpack.config.js --env target=dev --watch",
    "format": "prettier --write .",
    "i18n:check": "node scripts/audit-i18n.mjs",
    "i18n:fix": "node scripts/audit-i18n.mjs --fix",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "metadata:download": "node scripts/download-offline-metadata.mjs",
    "metadata:extract-hars": "node scripts/ingest-hars-to-metadata.mjs",
    "metadata:query": "node scripts/query-metadata-store.mjs",
    "package:beta": "npm run verify && node scripts/package-extension.js --env=beta",
    "prepare": "husky",
    "release": "node scripts/release.mjs",
    "release:prod": "npm run lint && npm run test && npm run build:prod && node scripts/package-extension.js --env=prod",
    "rpc:contract": "node scripts/rpc-contract.mjs",
    "rpc:contract:check": "node scripts/rpc-contract.mjs --check",
    "setup": "node scripts/setup.mjs",
    "test": "node --test --test-reporter=dot tests/**/*.test.mjs",
    "test:verbose": "node --test tests/**/*.test.mjs",
    "test:watch": "node --test --watch tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run lint && npm run typecheck && npm run rpc:contract:check && npm run i18n:check && npm test && npm run build:dev"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bignumber.js": "^11.1.5",
    "bootstrap": "^5.3.8",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/webextension-polyfill": "^0.12.6",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "3.9.8",
    "prettier-plugin-packagejson": "^3.0.2",
    "sass": "^1.105.0",
    "sass-loader": "^17.0.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true
  }
}
