{
  "name": "foe-info",
  "version": "0.0.831",
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@wikimedia/jquery.i18n": "1.0.9",
    "bignumber.js": "^11.1.5",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.21",
    "jquery": "^4.0.0",
    "webextension-polyfill": "^0.12.0",
    "webhook-discord": "^3.7.8"
  },
  "license": "AGPL-3.0-or-later",
  "repository": "",
  "private": true,
  "scripts": {
    "setup": "mise run setup || (npm install && (command -v uv >/dev/null 2>&1 || (command -v pipx >/dev/null 2>&1 && pipx install \"graphifyy[gemini,mcp]==0.9.36\" || pip install \"graphifyy[gemini,mcp]==0.9.36\")))",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "dev": "cross-env NODE_ENV=development webpack --config webpack.dev.js --watch",
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.dev.js",
    "build": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "outdated": "npx --yes npm-check-updates@23.0.1",
    "analyze": "cross-env ANALYZE=true NODE_ENV=production webpack --config webpack.prod.js",
    "test:graphify-report": "node scripts/graphify-filter-surprises.test.mjs",
    "graphify-filter-surprises": "node scripts/graphify-filter-surprises.mjs",
    "graphify-update": "UV_CACHE_DIR=\"$PWD/.cache/uv\"; UV_TOOL_DIR=\"$PWD/.cache/uv/tools\"; export UV_CACHE_DIR UV_TOOL_DIR; (command -v uvx >/dev/null 2>&1 && uvx --from \"graphifyy[gemini,mcp]==0.9.36\" graphify update . || (command -v pipx >/dev/null 2>&1 && pipx run --spec \"graphifyy[gemini,mcp]==0.9.36\" graphify update . || graphify update .)) && npm run graphify-filter-surprises"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-extension-manifest-plugin": "^0.8.0",
    "webpack-merge": "^6.0.1",
    "zip-webpack-plugin": "^4.0.3"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ]
}
