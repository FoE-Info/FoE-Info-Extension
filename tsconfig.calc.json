{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Incremental JS type-checking boundary: start on the pure math modules
    // in src/js/calc/** (BigNumber math, no DOM/network side effects).
    // The repo-wide tsconfig sets checkJs with four opted-in calc leaves
    // (bignumberUtils, eraUtils, goodsClassification, CastleBoostCalculator);
    // this config widens the boundary to all of calc/.
    "checkJs": true
  },
  "include": ["src/js/calc/**/*"]
}
