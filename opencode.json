{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "instructions": [".agents/rules/*.md", ".opencode/instructions/*.md"],
  "plugins": [
    ".opencode/plugins/safety-gate.mjs",
    ".opencode/plugins/graphify-guard.mjs",
    ".opencode/plugins/graphify-sync.mjs",
    ".opencode/plugins/stop-guard.mjs"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["bash", ".agents/scripts/run-chrome-devtools-mcp.sh"],
      "enabled": true
    },
    "graphify-foe-info": {
      "type": "local",
      "command": ["graphify-mcp", "graphify-out/foe-info/graph.json"],
      "environment": {
        "GRAPHIFY_BACKEND": "openai",
        "OPENAI_BASE_URL": "http://127.0.0.1:8081/v1",
        "OPENAI_API_KEY": "local",
        "OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_NO_TIPS": "1",
        "NO_PROXY": "*",
        "no_proxy": "*",
        "GEMINI_API_KEY": "",
        "GOOGLE_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "MOONSHOT_API_KEY": "",
        "DEEPSEEK_API_KEY": "",
        "AZURE_OPENAI_API_KEY": "",
        "AZURE_OPENAI_ENDPOINT": "",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "http_proxy": "",
        "https_proxy": "",
        "all_proxy": ""
      },
      "enabled": true
    },
    "graphify-forge-hammer": {
      "type": "local",
      "command": ["graphify-mcp", "../forge-hammer/graphify-out/graph.json"],
      "environment": {
        "GRAPHIFY_BACKEND": "openai",
        "OPENAI_BASE_URL": "http://127.0.0.1:8081/v1",
        "OPENAI_API_KEY": "local",
        "OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_NO_TIPS": "1",
        "NO_PROXY": "*",
        "no_proxy": "*",
        "GEMINI_API_KEY": "",
        "GOOGLE_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "MOONSHOT_API_KEY": "",
        "DEEPSEEK_API_KEY": "",
        "AZURE_OPENAI_API_KEY": "",
        "AZURE_OPENAI_ENDPOINT": "",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "http_proxy": "",
        "https_proxy": "",
        "all_proxy": ""
      },
      "enabled": true
    },
    "graphify-foe-info-original": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "../FoE-Info-Extension-original/graphify-out/graph.json"
      ],
      "environment": {
        "GRAPHIFY_BACKEND": "openai",
        "OPENAI_BASE_URL": "http://127.0.0.1:8081/v1",
        "OPENAI_API_KEY": "local",
        "OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_NO_TIPS": "1",
        "NO_PROXY": "*",
        "no_proxy": "*",
        "GEMINI_API_KEY": "",
        "GOOGLE_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "MOONSHOT_API_KEY": "",
        "DEEPSEEK_API_KEY": "",
        "AZURE_OPENAI_API_KEY": "",
        "AZURE_OPENAI_ENDPOINT": "",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "http_proxy": "",
        "https_proxy": "",
        "all_proxy": ""
      },
      "enabled": true
    },
    "graphify-low-tool": {
      "type": "local",
      "command": ["graphify-mcp", "../LoW-Tool/graphify-out/graph.json"],
      "environment": {
        "GRAPHIFY_BACKEND": "openai",
        "OPENAI_BASE_URL": "http://127.0.0.1:8081/v1",
        "OPENAI_API_KEY": "local",
        "OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_NO_TIPS": "1",
        "NO_PROXY": "*",
        "no_proxy": "*",
        "GEMINI_API_KEY": "",
        "GOOGLE_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "MOONSHOT_API_KEY": "",
        "DEEPSEEK_API_KEY": "",
        "AZURE_OPENAI_API_KEY": "",
        "AZURE_OPENAI_ENDPOINT": "",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "http_proxy": "",
        "https_proxy": "",
        "all_proxy": ""
      },
      "enabled": true
    },
    "graphify-metadata-store": {
      "type": "local",
      "command": ["graphify-mcp", "../metadata-store/graphify-out/graph.json"],
      "environment": {
        "GRAPHIFY_BACKEND": "openai",
        "OPENAI_BASE_URL": "http://127.0.0.1:8081/v1",
        "OPENAI_API_KEY": "local",
        "OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_OPENAI_MODEL": "qwen2.5-vl-7b",
        "GRAPHIFY_NO_TIPS": "1",
        "NO_PROXY": "*",
        "no_proxy": "*",
        "GEMINI_API_KEY": "",
        "GOOGLE_API_KEY": "",
        "ANTHROPIC_API_KEY": "",
        "MOONSHOT_API_KEY": "",
        "DEEPSEEK_API_KEY": "",
        "AZURE_OPENAI_API_KEY": "",
        "AZURE_OPENAI_ENDPOINT": "",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "http_proxy": "",
        "https_proxy": "",
        "all_proxy": ""
      },
      "enabled": true
    },
    "github-mcp": {
      "type": "local",
      "command": ["bash", ".agents/scripts/run-github-mcp.sh"],
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git fetch*": "allow",
      "npm test*": "allow",
      "npm run verify*": "allow",
      "npm run lint*": "allow",
      "npm run check*": "allow",
      "npm run format*": "allow",
      "npm run i18n*": "allow",
      "npm run build*": "allow",
      "npm run graph:*": "allow",
      "npm run typecheck*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git stash*": "ask",
      "rm *": "ask"
    }
  }
}
