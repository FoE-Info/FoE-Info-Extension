# Graph scope includes extension source and selected canonical project guidance.
# Git publication policy is separate and lives in .gitignore.
/*
!/src/
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/AGENTS.md
!/docs/
/docs/*
!/docs/architecture.md
!/docs/debugging.md
!/docs/repository-contracts.md
!/docs/validation-harness.md
!/.agents/
/.agents/*
!/.agents/rules/

# Colocated source documentation is outside the selected canonical doc set.
/src/**/*.md
/src/**/*.mdx
/src/**/*.rst

# Media & Binary Assets (avoids vision/parser overhead)
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.cur
*.webp
*.svg
*.woff
*.woff2
*.mp3
*.wav
*.ogg

# Generated query memories must never become source graph nodes.
/graphify-out/

# Generated Graphify query memory is local, never source.
/graphify-out/memory/
