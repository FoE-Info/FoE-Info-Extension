# Dependencies
node_modules/
.venv/
.uv/

# Credentials and generated local runtime state; agent harness sources are shared
.env
.env.*
.envrc
/.codex/auth.json
/.agents/.last_graph_query_stamp
/.husky/.graphify-python

# Build & Distribution Artifacts
build/
*.zip
*.crx

# IDE & Editor Files
.vscode/

# Shared Graphify products and portable incremental/label state only.
# Everything else (caches, backups, exports, raw memory, findings, runtime
# markers, and analysis/learning sidecars) stays local. See CONTRIBUTING.md.
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/graph.html
!/graphify-out/manifest.json
!/graphify-out/.graphify_labels.json
!/graphify-out/.graphify_labels.json.sig

# Generated Graphify query memory is local, never source.
/graphify-out/memory/
