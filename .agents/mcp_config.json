{
  "mcpServers": {
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[gemini,mcp]==0.9.36",
        "graphify-mcp",
        "graphify-out/graph.json"
      ]
    },
    "chrome_devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.6.0",
        "--auto-connect",
        "--experimentalMemory",
        "--experimentalScreencast"
      ]
    }
  }
}
