    "github-mcp": {
      "antigravity": {
        "command": "docker",
        "args": [
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ]
      }
    },
    "linux-tools": {
      "antigravity": {
        "command": "linux-mcp-server",
        "args": [],
        "env": {
          "LINUX_MCP_LOG_LEVEL": "INFO",
          "LINUX_MCP_USER": "${USER}",
          "LINUX_MCP_SSH_KEY_PATH": "${HOME}/.ssh/id_ed25519"
        }
      }
    }
