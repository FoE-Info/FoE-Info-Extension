{
  "profiles": {
    "default": ["graphify-foe-info"],
    "browser": ["graphify-foe-info", "chrome-devtools"],
    "research": [
      "graphify-foe-info",
      "graphify-forge-hammer",
      "graphify-foe-info-original",
      "graphify-low-tool",
      "graphify-metadata-store"
    ],
    "github": ["graphify-foe-info", "github-mcp"],
    "linux": ["graphify-foe-info", "linux-tools"],
    "full": [
      "chrome-devtools",
      "graphify-foe-info",
      "graphify-forge-hammer",
      "graphify-foe-info-original",
      "graphify-low-tool",
      "graphify-metadata-store",
      "github-mcp",
      "linux-tools"
    ]
  },
  "servers": {
    "chrome-devtools": {
      "antigravity": {
        "command": "chrome-devtools-mcp",
        "args": [
          "--browserUrl=http://127.0.0.1:9222",
          "--experimentalMemory",
          "--experimentalVision",
          "--categoryExperimentalWebmcp",
          "--experimentalDevtools",
          "--experimentalIncludeAllPages",
          "--experimentalPageIdRouting",
          "--allowUnrestrictedPaths",
          "--no-usage-statistics"
        ]
      }
    },
    "graphify-foe-info": {
      "antigravity": {
        "command": "graphify-mcp",
        "args": ["graphify-out/foe-info/graph.json"],
        "env": {
          "GRAPHIFY_BACKEND": "openai",
          "OPENAI_BASE_URL": "http://127.0.0.1:8081/v1",
          "OPENAI_API_KEY": "local",
          "OPENAI_MODEL": "qwen2.5-vl-7b",
          "GRAPHIFY_OPENAI_MODEL": "qwen2.5-vl-7b",
          "GRAPHIFY_NO_TIPS": "1",
          "NO_PROXY": "*",
          "no_proxy": "*",
          "GEMINI_API_KEY": "",
          "GOOGLE_API_KEY": "",
          "ANTHROPIC_API_KEY": "",
          "MOONSHOT_API_KEY": "",
          "DEEPSEEK_API_KEY": "",
          "AZURE_OPENAI_API_KEY": "",
          "AZURE_OPENAI_ENDPOINT": "",
          "HTTP_PROXY": "",
          "HTTPS_PROXY": "",
          "ALL_PROXY": "",
          "http_proxy": "",
          "https_proxy": "",
          "all_proxy": ""
        }
      }
    },
    "graphify-forge-hammer": {
      "antigravity": {
        "command": "graphify-mcp",
        "args": ["../forge-hammer/graphify-out/graph.json"],
        "env": {
          "GRAPHIFY_BACKEND": "openai",
          "OPENAI_BASE_URL": "http://127.0.0.1:8081/v1",
          "OPENAI_API_KEY": "local",
          "OPENAI_MODEL": "qwen2.5-vl-7b",
          "GRAPHIFY_OPENAI_MODEL": "qwen2.5-vl-7b",
          "GRAPHIFY_NO_TIPS": "1",
          "NO_PROXY": "*",
          "no_proxy": "*",
          "GEMINI_API_KEY": "",
          "GOOGLE_API_KEY": "",
          "ANTHROPIC_API_KEY": "",
          "MOONSHOT_API_KEY": "",
          "DEEPSEEK_API_KEY": "",
          "AZURE_OPENAI_API_KEY": "",
          "AZURE_OPENAI_ENDPOINT": "",
          "HTTP_PROXY": "",
          "HTTPS_PROXY": "",
          "ALL_PROXY": "",
          "http_proxy": "",
          "https_proxy": "",
          "all_proxy": ""
        }
      }
    },
