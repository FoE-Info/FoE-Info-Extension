{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/safety-gate.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "monolith-guardrail": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/pre-invocation-reminder.mjs",
        "timeout": 5
      }
    ]
  },
  "graphify-sync": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/post-tool-graphify-sync.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "stop-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/stop-guard.mjs",
        "timeout": 5
      }
    ]
  }
}
