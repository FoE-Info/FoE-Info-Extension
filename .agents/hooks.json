{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/safety-gate.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "graphify-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/graphify-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/graphify-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/graphify-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/graphify-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
