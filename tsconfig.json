{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["chrome", "webextension-polyfill", "node"]
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/js/calc/utils/bignumberUtils.js",
    "src/js/calc/utils/eraUtils.js",
    "src/js/calc/goods/goodsClassification.js",
    "src/js/calc/boosts/CastleBoostCalculator.js"
  ]
}
